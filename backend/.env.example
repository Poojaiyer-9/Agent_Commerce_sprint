# Razorpay TEST-MODE credentials (never commit real values)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# LLM provider for the Shopping/Upsell agents' reasoning steps
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite audit trail DB path
AUDIT_DB_PATH=./audit_trail.db

# Policy Agent guardrail bounds (paise = INR * 100)
POLICY_MAX_SINGLE_ITEM_PRICE_PAISE=500000
POLICY_MAX_CART_VALUE_PAISE=1000000
POLICY_MAX_RETRY_ATTEMPTS=2
POLICY_RATE_LIMIT_ACTIONS=5
POLICY_RATE_LIMIT_WINDOW_SECONDS=60

# CORS
FRONTEND_ORIGIN=http://localhost:5173
